{
  "_calibration": "gated: fetched from the reference dataset and merged by fetch_reference.py",
  "_pack": {
    "reference": {
      "fetch_into": "reference/ before grading - see reference/README.md",
      "files": [
        "consensus_mask.nii.gz",
        "consensus_zones.nii.gz (0=bg,1=margin,2=core)"
      ],
      "host": "Hugging Face neurodeskorg/skills-comm-ground-truth, path structural_gt/structural-brain-extraction-pediatric/"
    }
  },
  "focal_bg_max_cm3": 10.0,
  "gates": [
    "binary",
    "no_catastrophic_core_loss",
    "no_focal_bg_inclusion",
    "no_focal_core_loss",
    "no_internal_holes",
    "nonempty",
    "single_component",
    "stripped_matches_mask",
    "volume_plausible"
  ],
  "plausible_volume_cm3": [
    900.0,
    1900.0
  ],
  "slack": 1.5,
  "verdict_thresholds": {
    "acceptable": 60,
    "marginal": 30
  },
  "weights": {
    "abs_volume_err_pct": 0.1,
    "bg_fp_frac_of_ref": 0.2,
    "core_recall": 0.25,
    "hd95_mm": 0.15,
    "nsd": 0.3
  },
  "_subject": "gated: the subject's own fields (item, prompt, grid) are fetched from the reference dataset, rubrics/<task>/<subject>.json, and merged by fetch_reference.py"
}
