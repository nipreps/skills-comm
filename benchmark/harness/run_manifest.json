  "schema_version": "1.0",
  "description": "Drives the automated grading plane. One entry per gradeable task. Paths are relative to graders_root (default: the parent of this file's dir, i.e. benchmark/) except submission paths, which are relative to --submission-dir and templated with {task_id}. The agent writes its result to submissions/<task_id>/output.nii.gz; the grader reads ONLY that path (no fuzzy file discovery). Tasks marked per_subject run once per case of theirs in the reference dataset's cases.json (harness/cases.py): a run names the case, the gated file names the subject; {subject} in ref_dir and in submission paths is substituted with that id.",
  "defaults": {
    "submission_output_path": "submissions/{task_id}/output.nii.gz",
    "reference_repo": "neurodeskorg/skills-comm-ground-truth",
    "reference_repo_type": "dataset",
    "reference_revision": "bb49fb08210d",
    "submission_path": "submissions/{task_id}/{subject}/output.nii.gz",
    "cases_file": "cases.json"
  },
